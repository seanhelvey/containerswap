# Copy to .env for local dev. NEVER commit .env.
# In production set these as environment variables in the FastAPI Cloud dashboard.

# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CS_SECRET_KEY=dev-only-insecure-change-me

# false in production (enables secure cookies, disables tracebacks)
CS_DEBUG=true

# Postgres. The default matches docker-compose.yml, so local dev needs nothing here.
# In production use Supabase's TRANSACTION POOLER (port 6543) — zero-downtime deploys
# run several instances at once and the direct connection's limit is far too low.
CS_DATABASE_URL=postgresql+psycopg://containerswap:localdev@localhost:5433/containerswap

# Only Alembic uses this, and only in production: DDL through the transaction pooler
# is unreliable, so point it at the DIRECT connection (port 5432). Empty locally.
CS_MIGRATION_DATABASE_URL=

# Object storage for listing photos. Leave all three empty locally and uploads go to
# CS_DATA_DIR instead. In production set all three, and mark the service key Secret
# AT CREATION in the FastAPI Cloud dashboard — the toggle is gone afterwards.
# The service key is server-side only. It must never reach a template or a log line.
CS_SUPABASE_URL=
CS_SUPABASE_SERVICE_KEY=
CS_STORAGE_BUCKET=listing-photos

# Local scratch space: uploads when no object store is configured. There is no
# persistent volume in production, so anything here is lost on the next redeploy.
CS_DATA_DIR=data

# Local flavour. Empty = plain global framing. Set to e.g. "Humboldt County" for the
# grassroots instance; the code stays global either way.
CS_HOME_REGION=

# Where the map opens when a visitor has not shared their location.
CS_DEFAULT_LAT=40.8021
CS_DEFAULT_LNG=-124.1637
CS_DEFAULT_ZOOM=9
