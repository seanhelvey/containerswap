# Copy to .env for local dev. NEVER commit .env.
# In production set these as environment variables in the FastAPI Cloud dashboard.

# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CS_SECRET_KEY=dev-only-insecure-change-me

# false in production (enables secure cookies, disables tracebacks)
CS_DEBUG=true

# Where the SQLite db and uploaded images live. Point at a persistent volume in prod.
CS_DATA_DIR=data

# Local flavour. Empty = plain global framing. Set to e.g. "Humboldt County" for the
# grassroots instance; the code stays global either way.
CS_HOME_REGION=

# Where the map opens when a visitor has not shared their location.
CS_DEFAULT_LAT=40.8021
CS_DEFAULT_LNG=-124.1637
CS_DEFAULT_ZOOM=9
