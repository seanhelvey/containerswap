#!/usr/bin/env bash
# Pushing main deploys to production and CI does not gate the deploy.
# This is the last thing standing between a red test and real users.
set -euo pipefail

branch="$(git rev-parse --abbrev-ref HEAD)"
[ "$branch" = "main" ] || exit 0

echo "pre-push: main deploys on push — running checks"
uv run ruff check . || { echo "pre-push: lint failed"; exit 1; }
uv run pytest -q || { echo "pre-push: tests failed"; exit 1; }

# Production must already be migrated. The deploy starts the moment this push lands
# and there is no release phase, so new code would otherwise boot against the old
# schema. Migrating first is safe because migrations are additive: the old instances
# keep serving through the rollover.
# Ask the app, not the shell: the URL may come from .env, and when it is absent
# alembic silently falls back to the local database — which is always at head and
# would report a false green.
target_host="$(uv run python -c "
from sqlalchemy.engine.url import make_url
from app.config import settings
print(make_url(settings.alembic_url).host or '')
" 2>/dev/null)"

case "$target_host" in
  ""|localhost|127.0.0.1|::1) is_remote=0 ;;
  *) is_remote=1 ;;
esac

if [ "$is_remote" = "1" ]; then
  local_head="$(uv run alembic heads 2>/dev/null | awk 'NR==1{print $1}')"
  prod_rev="$(uv run alembic current 2>/dev/null | awk '/^[0-9a-f]{12}/{print $1}')"
  if [ "$local_head" != "$prod_rev" ]; then
    echo "pre-push: production is at '${prod_rev:-<none>}', repo head is '${local_head}'"
    echo "pre-push: migrate first —"
    echo "  CS_MIGRATION_DATABASE_URL='...' uv run alembic upgrade head"
    exit 1
  fi
  echo "pre-push: production (${target_host}) is at ${prod_rev}"
else
  # Not fatal: refusing every push because a secret is absent would just train you
  # to use --no-verify, which disables the test gate above too.
  echo "pre-push: WARNING — CS_MIGRATION_DATABASE_URL not pointing at a remote host;"
  echo "pre-push: cannot verify production schema. Check it before this deploy lands."
fi

echo "pre-push: ok"
